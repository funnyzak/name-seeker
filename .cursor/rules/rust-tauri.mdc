    pub percentage: f64,
}
```

## 🛡️ 安全性

### 输入验证
- 验证所有用户输入
- 使用正则表达式验证格式
- 防止注入攻击

```rust
// ✅ 正确的输入验证
pub fn validate_username(username: &str) -> Result<(), SearchError> {
    if username.is_empty() {
        return Err(SearchError::ValidationError("用户名不能为空".to_string()));
    }
    
    if username.len() > 50 {
        return Err(SearchError::ValidationError("用户名过长".to_string()));
    }
    
    // 检查用户名格式
    let username_regex = Regex::new(r"^[a-zA-Z0-9._-]+$")?;
    if !username_regex.is_match(username) {
        return Err(SearchError::ValidationError("用户名格式无效".to_string()));
    }
    
    Ok(())
}
```

### 错误处理
- 不要暴露内部错误信息
- 记录详细的错误日志
- 提供用户友好的错误消息

```rust
// ✅ 正确的错误处理
#[tauri::command]
async fn start_search(query: String) -> Result<(), String> {
    match perform_search(&query).await {
        Ok(_) => Ok(()),
        Err(SearchError::NetworkError(e)) => {
            log::error!("网络错误: {}", e);
            Err("网络连接失败，请检查网络设置".to_string())
        }
        Err(SearchError::ValidationError(msg)) => {
            log::warn!("验证错误: {}", msg);
            Err(msg)
        }
        Err(e) => {
            log::error!("未知错误: {}", e);
            Err("搜索失败，请稍后重试".to_string())
        }
    }
}
```

## 📝 日志记录

### 日志级别
- 使用 `log` crate 进行日志记录
- 合理设置日志级别
- 记录关键操作和错误

```rust
// ✅ 正确的日志记录
use log::{info, warn, error, debug};

pub async fn search_username(query: &str) -> Result<Vec<SearchResult>, SearchError> {
    info!("开始搜索用户名: {}", query);
    
    let results = perform_search(query).await?;
    
    info!("搜索完成，找到 {} 个结果", results.len());
    
    Ok(results)
}
```

### 日志配置
- 在应用启动时配置日志
- 使用环境变量控制日志级别
- 记录到文件和控制台

```rust
// ✅ 正确的日志配置
pub fn init_logging() {
    env_logger::Builder::from_default_env()
        .filter_level(log::LevelFilter::Info)
        .format(|buf, record| {
            writeln!(buf, "{} [{}] {}", 
                chrono::Local::now().format("%Y-%m-%d %H:%M:%S"),
                record.level(),
                record.args()
            )
        })
        .init();
}
```

## 🧪 测试

### 单元测试
- 为每个函数编写测试
- 使用 `#[cfg(test)]` 标记测试模块
- 测试正常情况和边界情况

```rust
// ✅ 正确的单元测试
#[cfg(test)]
mod tests {
    use super::*;
    
    #[test]
    fn test_validate_username() {
        assert!(validate_username("testuser").is_ok());
        assert!(validate_username("").is_err());
        assert!(validate_username("a".repeat(51)).is_err());
    }
    
    #[tokio::test]
    async fn test_search_username() {
        let result = search_username("testuser").await;
        assert!(result.is_ok());
    }
}
```

### 集成测试
- 测试 Tauri 命令
- 测试事件系统
- 测试完整的搜索流程

```rust
// ✅ 正确的集成测试
#[cfg(test)]
mod integration_tests {
    use tauri::test;
    
    #[tokio::test]
    async fn test_start_search_command() {
        let app = test::mock_app();
